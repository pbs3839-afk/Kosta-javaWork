/**
 *  여러 스레드가 공유할 객체
 * */
 class Bank{
	 int balance;//0
	 
	 public void balanceChange(String name, boolean state) {
		 if(state) {//입금
			 System.out.print(name+ "===> 현재 잔액 : " + balance + "/");
			 balance++;
			 System.out.println(name+"===> 입금 후 현재 잔액 : " + balance);
		 }else {//출금
			 System.out.print(name+ "===> 현재 잔액 : " + balance + "/");
			 balance--;
			 System.out.println(name+"===> 출금 후 현재 잔액 : " + balance);
		 }
	 }
 }
