package ex0803.array;

import java.util.Scanner;

class ArrayExam{
	//각int,double,char,boolean ,String type별로 총 5개씩 저장하는  배열을 생성하세요
	int iarr [] = new int [5]; 
	double darr [] = new double [5];
	char carr [] = new char [5]; 
	boolean barr [] = new boolean [5]; 
	String sarr [] = new String [5]; 
	

	//메소드 : printArrayValue01	
	//위의 배열들에 자동으로 초기화 된값을 출력하세요
	public void printArrayValue01() {
		int len = iarr.length;
		int den = darr.length;
		int cen = carr.length;
		int ben = barr.length;
		int sen = sarr.length;
		System.out.println("iarr = " + iarr);
				System.out.println("배열의 길이 = " + len);
		for(int i =0; i<len; i++) {
			System.out.println("iarr["+i+"] =" + iarr[i] );
		}
		System.out.println("==========");
		for(int d =0; d<den; d++) {
			System.out.println("darr["+d+"] =" + darr[d] );
		}
		for(int c =0; c<cen; c++) {
			System.out.println("carr["+c+"] =" + carr[c] );
		}
		for(int b =0; b<ben; b++) {
			System.out.println("barr["+b+"] =" + barr[b] );
		}
		for(int s =0; s<sen; s++) {
			System.out.println("barr["+s+"] =" + sarr[s] );
		}
	}

	//메소드 : printArrayValue02	
	//위의 5개의 배열에서 각각 적당한 값으로 data를 할당하세요.
	public void printArrayValue02() {
