		int den = darr.length;
		int cen = carr.length;
		int ben = barr.length;
		int sen = sarr.length;
		for(int i =0; i<len; i++) {
			System.out.println("iarr["+i+"] =" + iarr[i] );
		}
		System.out.println("==========");
		for(int d =0; d<den; d++) {
			System.out.println("darr["+d+"] =" + darr[d] );
		}
		for(int c =0; c<cen; c++) {
			System.out.println("carr["+c+"] =" + carr[c] );
		}
		for(int b =0; b<ben; b++) {
			System.out.println("barr["+b+"] =" + barr[b] );
		}
		for(int s =0; s<sen; s++) {
			System.out.println("barr["+s+"] =" + sarr[s] );
		}
}
	//메인메소드에서
	//ArrayExam의 메소드들을 순서대로 호출하세요.
	public static void main(String[] args) {
		Scanner sc= new Scanner(System.in);
		ArrayExam ae = new ArrayExam(); 
