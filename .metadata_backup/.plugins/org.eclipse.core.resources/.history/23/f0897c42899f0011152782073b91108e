package ex0824;

public class SynchronizedExam {

	public static void main(String[] args) {
		System.out.println("***메인 시작***");
		System.out.println("***메인 끝****");
	}

}

//////////////////////////////////////////////////////
/**
 * 여러 스레드가 공유할 객체
 */
class Bank {
	int balance;// 0

	public void balanceChange(String name, boolean state) {
		if (state) {// 입금
			System.out.print(name + "===> 현재 잔액 : " + balance + "/");
			balance++;
			System.out.println(name + "===> 입금 후 현재 잔액 : " + balance);
		} else {// 출금
			System.out.print(name + "===> 현재 잔액 : " + balance + "/");
			balance--;
			System.out.println(name + "===> 출금 후 현재 잔액 : " + balance);
		}
	}
}

//////////////////////////////////////////////
/**
 * 입금 또는 인출을 수행하는 스레드 객체
 */
class CustoberThread extends Thread {
	Bank bank;
	String name;
	boolean state;

	public CustoberThread(Bank bank, String name, boolean state) {
		super(name);
		this.bank = bank;
		this.name = name;
		this.state = state;
	}

	public void run() {
		for (int i = 0; i < 50; i++) {
			// Bank의 balanceChange 호출한다.
			bank.balanceChange(name, state);
		}
		System.out.println(name + "스레드가 종료합니다.");
	}
}
