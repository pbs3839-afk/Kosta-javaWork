		FileInputStream fis = null;
		try {

			fis = new FileInputStream("src/ex0820/a.txt");
			/*
			 * while(true) { int i = fis.read(); if(i==-1)break; System.out.println(i +
			 * " = " + (char)i); } System.out.println("**완료**");
			 */

			/////////////////////////////////////////////////////////////////////
			// byte [] 크기 만큼 한번에 읽기
			byte[] b = new byte[4];
			fis.read(b);

			System.out.println(b);

		} catch (IOException e) {

		} finally {
			try {
				if (fis != null)
					fis.close();
			} catch (Exception e) {
