	List<ClientSkThread> list = new ArrayList<ServerGUIChatExam.ClientSkThread>();
	Socket sk;

	public ServerGUIChatExam() {
		try (ServerSocket server = new ServerSocket(8002)) {
			while (true) {
				System.out.println("Client 접속 대기중입니다.");
				sk = server.accept();
